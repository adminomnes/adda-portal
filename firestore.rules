rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Only allow creation of own profile with role='alumno'
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.role == 'alumno';
      // Allow update of own profile except role
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Materials
    match /materials/{matId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Notices
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Support Internal
    match /support_internal/{ticketId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
